---
export type AgentIconKind = 'shield' | 'scales' | 'clipboard-check' | 'clipboard' | 'package';

interface Props {
  kind: AgentIconKind;
  class?: string;
}

const { kind, class: className = 'h-12 w-12' } = Astro.props;
const commonSvg = {
  viewBox: '0 0 48 48',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.5',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
};
---

{
  kind === 'shield' && (
    <svg xmlns="http://www.w3.org/2000/svg" class={className} {...commonSvg}>
      <path d="M24 4 L40 10 V24 C40 33 33.5 40.5 24 44 C14.5 40.5 8 33 8 24 V10 Z" />
      <rect x="19" y="23" width="10" height="9" rx="1" />
      <path d="M21 23 V19 a3 3 0 0 1 6 0 V23" />
    </svg>
  )
}

{
  kind === 'scales' && (
    <svg xmlns="http://www.w3.org/2000/svg" class={className} {...commonSvg}>
      <circle cx="24" cy="9" r="1.8" />
      <line x1="24" y1="11" x2="24" y2="41" />
      <line x1="15" y1="41" x2="33" y2="41" />
      <line x1="10" y1="15" x2="38" y2="15" />
      <line x1="10" y1="15" x2="10" y2="19" />
      <line x1="38" y1="15" x2="38" y2="19" />
      <path d="M5 19 L15 19 L12 27 C12 28 11 28.5 10 28.5 C9 28.5 8 28 8 27 Z" />
      <path d="M33 19 L43 19 L40 27 C40 28 39 28.5 38 28.5 C37 28.5 36 28 36 27 Z" />
    </svg>
  )
}

{
  kind === 'clipboard-check' && (
    <svg xmlns="http://www.w3.org/2000/svg" class={className} {...commonSvg}>
      <rect x="10" y="9" width="28" height="33" rx="2" />
      <rect x="18" y="5" width="12" height="7" rx="1.2" />
      <polyline points="17 26 22 31 32 19" />
    </svg>
  )
}

{
  kind === 'clipboard' && (
    <svg xmlns="http://www.w3.org/2000/svg" class={className} {...commonSvg}>
      <rect x="10" y="9" width="28" height="33" rx="2" />
      <rect x="18" y="5" width="12" height="7" rx="1.2" />
      <line x1="16" y1="22" x2="32" y2="22" />
      <line x1="16" y1="28" x2="32" y2="28" />
      <line x1="16" y1="34" x2="26" y2="34" />
    </svg>
  )
}

{
  kind === 'package' && (
    <svg xmlns="http://www.w3.org/2000/svg" class={className} {...commonSvg}>
      <path d="M8 14 L24 6 L40 14 V34 L24 42 L8 34 Z" />
      <path d="M8 14 L24 22 L40 14" />
      <line x1="24" y1="22" x2="24" y2="42" />
      <path d="M16 10 L32 18" />
      <polyline points="30 28 32.5 30.5 38 25" />
    </svg>
  )
}
