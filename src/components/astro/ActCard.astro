---
import StatusPill from './StatusPill.astro';

type Status = 'blocked' | 'provisional' | 'escalated' | 'complete' | 'resolved';

interface Props {
  act: string;
  title: string;
  lede: string;
  status?: Status;
  citation?: string;
}

const { act, title, lede, status, citation } = Astro.props;
---

<article class="group relative flex gap-6 border-t border-ink-100 py-8 md:gap-10">
  <div class="hidden shrink-0 md:block">
    <p class="font-serif text-5xl font-semibold tracking-tight text-ink-200 group-hover:text-accent transition-colors">
      {act}
    </p>
  </div>
  <div class="flex-1">
    <div class="flex flex-wrap items-center gap-3">
      <p class="eyebrow text-ink-400 md:hidden">Act {act}</p>
      {status && <StatusPill status={status} size="sm" />}
    </div>
    <h3 class="mt-3 font-serif text-2xl font-semibold tracking-tight text-ink-900">
      {title}
    </h3>
    <p class="mt-3 max-w-prose text-base leading-relaxed text-ink-600">{lede}</p>
    <div class="mt-4 prose-narrative text-sm">
      <slot />
    </div>
    {
      citation && (
        <p class="mt-4 font-mono text-xs text-ink-400">{citation}</p>
      )
    }
  </div>
</article>
