---
interface Props {
  index?: string | number;
  title: string;
}

const { index, title } = Astro.props;
---

<article
  class="group relative flex h-full flex-col rounded-lg border border-ink-100 bg-paper p-6 shadow-soft transition-colors hover:border-ink-200"
>
  {
    index !== undefined && (
      <span class="eyebrow mb-3 text-ink-400">
        {typeof index === 'number' ? String(index).padStart(2, '0') : index}
      </span>
    )
  }
  <h3 class="font-serif text-lg text-ink-900">{title}</h3>
  <div class="mt-3 text-sm leading-relaxed text-ink-600">
    <slot />
  </div>
</article>
