---
import Container from './Container.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const navItems = [
  { href: '/', label: 'Overview' },
  { href: '/demo', label: 'Demo' },
  { href: '/findings', label: 'Findings' },
];
---

<header class="sticky top-0 z-20 border-b border-ink-100 bg-paper/85 backdrop-blur">
  <Container width="wide" class="flex h-14 items-center justify-between">
    <a href="/" class="no-underline">
      <span class="font-serif text-base font-semibold text-ink-900">Spec-Driven Enterprise AI</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex items-center gap-6 text-sm">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'no-underline transition-colors',
                  isActive(item.href) ? 'text-ink-900' : 'text-ink-500 hover:text-ink-900',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>
