---
import Container from './Container.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));

const navItems = [
  { href: '/', label: 'Overview' },
  { href: '/demo', label: 'Demo' },
  { href: '/findings', label: 'Findings' },
];
---

<header class="sticky top-0 z-20 border-b border-ink-100 bg-paper/85 backdrop-blur">
  <Container width="wide" class="flex min-h-16 items-center justify-between gap-4 py-3">
    <a href="/" class="no-underline">
      <span class="block font-mono text-[0.68rem] uppercase tracking-[0.14em] text-ink-500"
        >Enterprise AI narrative</span
      >
      <span class="block font-serif text-base font-semibold text-ink-900"
        >Spec-Driven Context Engineering</span
      >
    </a>
    <nav aria-label="Primary">
      <ul
        class="flex items-center gap-1 rounded-full border border-ink-100 bg-paper-muted/80 p-1 text-sm shadow-soft"
      >
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'rounded-full px-4 py-2 no-underline transition-colors',
                  isActive(item.href)
                    ? 'bg-ink-900 text-paper'
                    : 'text-ink-500 hover:bg-paper hover:text-ink-900',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>
