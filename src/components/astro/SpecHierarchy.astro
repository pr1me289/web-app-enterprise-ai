---
interface Layer {
  label: string;
  name: string;
  jurisdiction: string;
}

interface Props {
  layers?: Layer[];
}

const defaultLayers: Layer[] = [
  {
    label: '01',
    name: 'PRD',
    jurisdiction: 'Product intent — what the system must do and for whom.',
  },
  {
    label: '02',
    name: 'Design Doc',
    jurisdiction: 'System architecture — how the system is shaped.',
  },
  {
    label: '03',
    name: 'Context Contract',
    jurisdiction: 'Retrieval + data — what each agent is allowed to see.',
  },
  {
    label: '04',
    name: 'Orchestration Plan',
    jurisdiction: 'Runtime execution — step order, gates, state mutations, and escalation flow.',
  },
  {
    label: '05',
    name: 'Agent Specs',
    jurisdiction: "Agent behavior — DOs, DON'Ts, output contracts.",
  },
];

const { layers = defaultLayers } = Astro.props;
---

<figure class="my-10">
  <ol class="relative overflow-hidden rounded-lg border border-ink-100 bg-paper shadow-soft">
    {
      layers.map((layer, i) => (
        <li
          class:list={[
            'grid grid-cols-[4rem_10rem_1fr] items-center gap-4 px-5 py-4',
            i !== layers.length - 1 ? 'border-b border-ink-100' : '',
          ]}
        >
          <span class="eyebrow text-ink-400">{layer.label}</span>
          <span class="font-serif text-base font-medium text-ink-900">{layer.name}</span>
          <span class="text-sm leading-relaxed text-ink-600">{layer.jurisdiction}</span>
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-3 text-xs text-ink-400">
    Conceptually four framing documents; in implementation, the orchestration plan became a distinct
    fifth runtime layer.
  </figcaption>
</figure>
