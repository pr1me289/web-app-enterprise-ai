---
interface Layer {
  label: string;
  name: string;
  jurisdiction: string;
  emergent?: boolean;
}

interface Props {
  layers?: Layer[];
  caption?: string;
}

const defaultLayers: Layer[] = [
  { label: '01', name: 'PRD', jurisdiction: 'Stakeholder intent — what the system must do and for whom.' },
  { label: '02', name: 'Design Doc', jurisdiction: 'System architecture — how the system is shaped.' },
  { label: '03', name: 'Context Contract', jurisdiction: 'Retrieval + data — what each agent is allowed to see, under what authority.' },
  {
    label: '04',
    name: 'Orchestration Plan',
    jurisdiction: 'Runtime execution — step sequencing, gate logic, PipelineState mutation rules.',
    emergent: true,
  },
  { label: '05', name: 'Agent Specs', jurisdiction: 'Behavioral rules — DOs, DON\'Ts, output contracts, citation discipline.' },
];

const {
  layers = defaultLayers,
  caption = 'The hierarchy was conceived as four documents. The Orchestration Plan emerged as a fifth under implementation pressure — it owns things the original four do not.',
} = Astro.props;
---

<figure class="my-10">
  <ol class="relative overflow-hidden rounded-lg border border-ink-100 bg-paper shadow-soft">
    {
      layers.map((layer, i) => (
        <li
          class:list={[
            'grid grid-cols-[3rem_10rem_1fr_auto] items-center gap-4 px-5 py-4',
            i !== layers.length - 1 ? 'border-b border-ink-100' : '',
            layer.emergent ? 'bg-paper-muted' : '',
          ]}
        >
          <span class="eyebrow text-ink-400">{layer.label}</span>
          <span class="font-serif text-base font-medium text-ink-900">{layer.name}</span>
          <span class="text-sm leading-relaxed text-ink-600">{layer.jurisdiction}</span>
          {layer.emergent && (
            <span class="rounded bg-accent-soft px-2 py-0.5 text-[0.65rem] font-medium uppercase tracking-wide text-accent">
              Emergent
            </span>
          )}
        </li>
      ))
    }
  </ol>
  <figcaption class="mt-4 max-w-prose text-xs leading-relaxed text-ink-500">{caption}</figcaption>
</figure>
