---
interface Props {
  value: string;
  label: string;
  source?: string;
  sourceHref?: string;
  emphasis?: boolean;
}

const { value, label, source, sourceHref, emphasis = false } = Astro.props;
---

<article
  class:list={[
    'flex h-full flex-col justify-between rounded-lg border p-6 transition-colors',
    emphasis
      ? 'border-ink-900 bg-paper-muted shadow-soft'
      : 'border-ink-100 bg-paper',
  ]}
>
  <div>
    <p
      class:list={[
        'font-bold tracking-tight text-ink-900',
        emphasis ? 'text-5xl md:text-6xl' : 'text-4xl md:text-5xl',
      ]}
      style="font-family: Georgia, serif;"
    >
      {value}
    </p>
    <p class="mt-4 text-sm leading-relaxed text-ink-700">{label}</p>
  </div>
  {
    source && (
      <p class="mt-6 eyebrow text-ink-400">
        {sourceHref ? (
          <a
            href={sourceHref}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ink-400 underline decoration-ink-200 decoration-1 underline-offset-4 transition-colors hover:text-ink-700 hover:decoration-ink-500"
          >
            {source}
          </a>
        ) : (
          source
        )}
      </p>
    )
  }
</article>
