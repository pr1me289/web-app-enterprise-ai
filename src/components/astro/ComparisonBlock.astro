---
interface Column {
  label: string;
  title: string;
  points: string[];
}

interface Props {
  left: Column;
  right: Column;
  emphasis?: 'left' | 'right';
}

const { left, right, emphasis = 'right' } = Astro.props;

const colBase = 'flex h-full flex-col rounded-lg border p-6 transition-colors';
const colMuted = 'border-ink-100 bg-paper-muted text-ink-500';
const colEmphasized = 'border-ink-900 bg-paper text-ink-800 shadow-soft';
---

<div class="mt-8 grid gap-4 md:grid-cols-2">
  <article class:list={[colBase, emphasis === 'left' ? colEmphasized : colMuted]}>
    <p class="eyebrow mb-2">{left.label}</p>
    <h3 class="font-serif text-lg text-ink-900">{left.title}</h3>
    <ul class="mt-4 space-y-2 text-sm leading-relaxed">
      {
        left.points.map((p) => (
          <li class="flex gap-2">
            <>
              <span aria-hidden class="text-ink-300">
                ·
              </span>
              <span>{p}</span>
            </>
          </li>
        ))
      }
    </ul>
  </article>
  <article class:list={[colBase, emphasis === 'right' ? colEmphasized : colMuted]}>
    <p class="eyebrow mb-2">{right.label}</p>
    <h3 class="font-serif text-lg text-ink-900">{right.title}</h3>
    <ul class="mt-4 space-y-2 text-sm leading-relaxed">
      {
        right.points.map((p) => (
          <li class="flex gap-2">
            <>
              <span aria-hidden class="text-accent">
                ·
              </span>
              <span>{p}</span>
            </>
          </li>
        ))
      }
    </ul>
  </article>
</div>
