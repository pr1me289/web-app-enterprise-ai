---
interface Headline {
  headlineSrc: string;
  logoSrc: string;
  source: string;
  headline: string;
}

interface Props {
  headlines: Headline[];
  ariaLabel?: string;
  durationSeconds?: number;
}

const { headlines, ariaLabel = 'Recent headlines', durationSeconds = 60 } = Astro.props;
---

<section class="marquee" aria-label={ariaLabel} style={`--marquee-duration: ${durationSeconds}s;`}>
  <div class="marquee__track">
    <ul class="marquee__group">
      {
        headlines.map((h) => (
          <li class="marquee__item">
            <img
              class="marquee__headline"
              src={h.headlineSrc}
              alt={`${h.source}: ${h.headline}`}
              loading="lazy"
              decoding="async"
            />
            <img
              class="marquee__logo"
              src={h.logoSrc}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))
      }
    </ul>
    <ul class="marquee__group" aria-hidden="true">
      {
        headlines.map((h) => (
          <li class="marquee__item">
            <img
              class="marquee__headline"
              src={h.headlineSrc}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <img class="marquee__logo" src={h.logoSrc} alt="" loading="lazy" decoding="async" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .marquee {
    --marquee-headline-height: 5.15rem;
    overflow: hidden;
    width: 100%;
    position: relative;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 6rem,
      #000 calc(100% - 6rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 6rem,
      #000 calc(100% - 6rem),
      transparent 100%
    );
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll var(--marquee-duration, 60s) linear infinite;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }

  .marquee__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 3.5rem;
    padding: 0 1.75rem;
    list-style: none;
    margin: 0;
  }

  .marquee__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .marquee__headline {
    height: var(--marquee-headline-height);
    width: auto;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .marquee__logo {
    height: 1.2rem;
    width: auto;
    padding: 0.18rem 0.4rem;
    background: #ffffff;
    border: 1px solid rgba(24, 33, 38, 0.12);
    border-radius: 999px;
    box-shadow:
      0 1px 2px rgba(24, 33, 38, 0.06),
      0 6px 14px -8px rgba(24, 33, 38, 0.18);
    user-select: none;
    -webkit-user-drag: none;
  }

  @keyframes marquee-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
