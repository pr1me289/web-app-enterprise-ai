---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/astro/Container.astro';
import NarrativeSection from '../components/astro/NarrativeSection.astro';
import SectionHero from '../components/astro/SectionHero.astro';
import Callout from '../components/astro/Callout.astro';
import ComparisonBlock from '../components/astro/ComparisonBlock.astro';
import CompetitorGrid from '../components/astro/CompetitorGrid.astro';
import PrincipleList from '../components/astro/PrincipleList.astro';
import SpecHierarchy from '../components/astro/SpecHierarchy.astro';
import TakeawayCard from '../components/astro/TakeawayCard.astro';
import Quote from '../components/astro/Quote.astro';
import StatBlock from '../components/astro/StatBlock.astro';
import HeadlineMarquee from '../components/astro/HeadlineMarquee.astro';
import DetailExpander from '../components/react/DetailExpander';

const parts = (await getCollection('parts')).sort((a, b) => a.data.order - b.data.order);
const titlePart = parts.find((p) => p.data.key === 'title')!;
const intro = parts.find((p) => p.data.key === 'introduction')!;
const problem = parts.find((p) => p.data.key === 'problem')!;
const approach = parts.find((p) => p.data.key === 'approach')!;
const scenario = parts.find((p) => p.data.key === 'scenario')!;

const TitleBody = await titlePart.render();
const IntroBody = await intro.render();
const ProblemBody = await problem.render();
const ApproachBody = await approach.render();
const ScenarioBody = await scenario.render();

const headlineTicker = [
  {
    source: 'The Wall Street Journal',
    headline: 'Companies Are Struggling to Drive a Return on AI. It Doesn’t Have to Be That Way.',
    headlineSrc: '/headlines/wsj-headline.png',
    logoSrc: '/headlines/wsj-logo.png',
  },
  {
    source: 'The New York Times',
    headline: 'Companies Are Pouring Billions Into A.I. It Has Yet to Pay Off.',
    headlineSrc: '/headlines/nyt-headline.png',
    logoSrc: '/headlines/nyt-logo.png',
  },
  {
    source: 'Forbes',
    headline: 'The Context Engine: Compounding Productivity For AI',
    headlineSrc: '/headlines/forbes-headline.png',
    logoSrc: '/headlines/forbes-logo.png',
  },
  {
    source: 'Fortune',
    headline: 'MIT report: 95% of generative AI pilots at companies are failing',
    headlineSrc: '/headlines/fortune-headline.png',
    logoSrc: '/headlines/fortune-logo.png',
  },
];

const framingCards = [
  {
    index: 'Method',
    title: 'Governed translation',
    body: 'Turn stakeholder intent, policy, and operational context into something agents can use safely and repeatably.',
  },
  {
    index: 'Workflow',
    title: 'Vendor onboarding',
    body: 'Use a real enterprise workflow with compliance, access control, and cross-functional handoffs as the proving ground.',
  },
  {
    index: 'Instance',
    title: 'Lichen + OptiChain',
    body: 'A fictional manufacturer and software vendor make the architecture concrete without pretending the scenario is the headline.',
  },
];

const landscapeLayers = [
  {
    title: 'Spec-driven layer',
    body: 'GitHub Spec Kit, Kiro, and adjacent tools prove specs matter. This project extends that idea into governed enterprise context.',
  },
  {
    title: 'Context engine layer',
    body: 'Unblocked, Augment, Sourcegraph, Tabnine, and others focus on organizational memory, permissions, and contextual recall.',
  },
  {
    title: 'Retrieval layer',
    body: 'Hybrid search, graph approaches, long-context strategies, and instructed retrieval all compete to improve evidence quality.',
  },
  {
    title: 'Runtime layer',
    body: 'MCP, A2A, and orchestration frameworks shift the question from pure search to controlled access and execution flow.',
  },
];

const contextEngines = [
  {
    name: 'Unblocked',
    angle: 'Authority signals — who reviewed whose code, who is the domain expert.',
  },
  {
    name: 'Augment Code',
    angle: 'Semantic dependency analysis across 400K+ files, SOC 2 Type II.',
  },
  { name: 'Qodo Context Engine', angle: 'Deep research agent; high DeepCodeBench accuracy.' },
  {
    name: 'Context Hub (Ng)',
    angle: 'Open-source CLI; agents annotate and "remember" workarounds.',
  },
  {
    name: 'Kayba ACE',
    angle: 'Self-improving via reflection; evolving "Skillbook" as system prompt.',
  },
  { name: 'Microsoft Agent Skills', angle: '126 modular knowledge packages for Azure / Foundry.' },
  { name: 'Tabnine ECE', angle: 'Privacy-first; on-prem or air-gapped deployments.' },
  {
    name: 'Greptile',
    angle: 'Graph-first semantic code graph; cross-service propagation detection.',
  },
  {
    name: 'Sourcegraph Amp',
    angle: 'Most established; enterprise knowledge graph; SOC 2 + ISO 27001.',
  },
  { name: 'Hyland ECE', angle: 'Broad content/process/people linking across ERP, CRM, EHR.' },
  { name: 'Faros Clara', angle: 'Enhanced AGENTS.md built from years of coding assistant usage.' },
  { name: 'Graphiti (Zep)', angle: 'Temporal knowledge graphs; time-aware fact management.' },
];

const pressurePoints = [
  {
    title: 'Context rot',
    body: 'More context is not uniformly better. Long prompts bury critical details and make rule adherence less reliable.',
  },
  {
    title: 'Authority conflicts',
    body: 'Vendor questionnaires, Slack threads, matrices, and policy PDFs are not equivalent sources. The system has to know that.',
  },
  {
    title: 'Temporal drift',
    body: 'The reason behind a current rule often lives in a prior decision or precedent, not in the latest artifact alone.',
  },
  {
    title: 'Runtime permissions',
    body: 'Access control is a live execution concern. Retrieval cannot be treated as an ungoverned pre-processing step.',
  },
];

const approachPrinciples = [
  {
    title: 'Center the translation layer',
    body: 'GitHub Spec Kit centers the spec. Kiro centers the workflow. This model centers the governed translation from enterprise intent into agent-usable context.',
  },
  {
    title: 'Keep orchestration deterministic',
    body: 'The supervisor is a plain Python state machine. It owns steps, gates, and mutations so failures stay inspectable.',
  },
  {
    title: 'Make retrieval source-aware',
    body: 'One giant index hides authority, permissions, and freshness. Per-source lanes keep those dimensions explicit.',
  },
  {
    title: 'Evaluate behavior, not fluency',
    body: 'A graceful hallucination is still a governance failure. Escalation discipline and evidence traceability are first-class criteria.',
  },
];

const retrievalFlow = [
  'Supervisor receives a pipeline task and decides what must be known.',
  'The task is decomposed into targeted subqueries rather than one vague search.',
  'A source router maps each subquery to the right retrieval lane.',
  'Dense, lexical, and direct structured lookups run in parallel where appropriate.',
  'Weak evidence is downweighted before anything reaches an agent.',
  'A scoped context bundle is assembled with authority and permissions intact.',
  'A domain agent reasons over the bundle and returns a structured determination.',
  'The supervisor updates pipeline state, preserves escalations, and decides what happens next.',
];

const executableContext = [
  'Instructions and non-goals',
  'Source priorities and authority tiers',
  'Retrieval endpoints and access bounds',
  'Examples, stop conditions, and tests',
  'Output contracts and escalation semantics',
];

const domainAgents = [
  {
    title: 'IT Security',
    body: 'Interprets policy, integration posture, and evidence sufficiency. Security is where policy precedence becomes operational.',
  },
  {
    title: 'Legal',
    body: 'Maps vendor facts to legal triggers such as DPA requirements, NDA gating, and contract execution ownership.',
  },
  {
    title: 'Procurement',
    body: 'Owns approval routing, commercial posture, and the difference between standard and exceptional purchase paths.',
  },
  {
    title: 'Checklist Assembler',
    body: 'Packages domain outputs without swallowing uncertainty. Escalated upstream items stay escalated here.',
  },
  {
    title: 'Checkoff',
    body: 'Emits the stakeholder-ready package: blockers, resolved items, owners, citations, and next actions.',
  },
];

const scenarioActs = [
  {
    index: 'Act 1',
    title: 'The intake gate fails first',
    body: 'The run begins blocked because the questionnaire is missing. That is a feature, not a bug. No downstream reasoning is allowed to improvise around a missing prerequisite.',
  },
  {
    index: 'Act 2',
    title: 'The path classifies as regulated',
    body: 'EU employee scheduling data plus ERP adjacency push the scenario onto the regulated path. Fast-track is denied early.',
  },
  {
    index: 'Act 3',
    title: 'Domain agents narrow the unresolved set',
    body: 'Legal escalates on the DPA and NDA. IT Security cannot cleanly classify the integration tier from questionnaire evidence alone. Procurement resolves approval path.',
  },
  {
    index: 'Act 4',
    title: 'The checklist preserves open work',
    body: 'The checklist is not a summary of confidence. It is an explicit package of blockers, resolved items, owners, and citations.',
  },
  {
    index: 'Act 5',
    title: 'Stakeholders get next-step guidance',
    body: 'The run ends escalated, not because the system failed, but because it correctly identified where human authority still belongs.',
  },
];
---

<BaseLayout title="Spec-Driven Enterprise AI">
  <section class="relative overflow-hidden border-b border-ink-100 bg-paper-muted">
    <Container width="wide" class="relative pb-24 pt-16 md:pb-32 md:pt-24">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(19rem,0.75fr)]">
        <div>
          <p class="eyebrow mb-5">{titlePart.data.eyebrow}</p>
          <h1
            class="display-balance max-w-[13ch] font-serif text-display-sm font-semibold tracking-tight text-ink-900 md:text-display"
          >
            {titlePart.data.title}
          </h1>
          {titlePart.data.lede && <p class="lede mt-7 max-w-2xl">{titlePart.data.lede}</p>}
          <div class="silver-panel prose-narrative mt-8 max-w-2xl text-[1.02rem]">
            <span class="silver-panel__corner silver-panel__corner--tl" aria-hidden="true"></span>
            <span class="silver-panel__corner silver-panel__corner--br" aria-hidden="true"></span>
            <TitleBody.Content />
          </div>

          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="/demo"
              class="inline-flex items-center gap-2 rounded-full bg-ink-900 px-5 py-3 text-sm font-medium text-paper no-underline shadow-soft transition-colors hover:bg-ink-800"
            >
              Skip to the replay
              <span aria-hidden>→</span>
            </a>
            <a
              href="/findings"
              class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-paper/90 px-5 py-3 text-sm font-medium text-ink-800 no-underline transition-colors hover:border-ink-900"
            >
              Read the findings
            </a>
          </div>

          <Quote source="Working thesis">
            The gap is not model capability. It is the governed translation from enterprise intent
            into executable context.
          </Quote>
        </div>

        <div class="panel p-6">
          <p class="eyebrow mb-6">The paradox</p>
          <div class="grid gap-4">
            <StatBlock
              value="80%"
              label="of enterprises believe in the transformative impact of AI and have invested accordingly."
              source="McKinsey · The State of AI"
              sourceHref="https://www.mckinsey.com/capabilities/people-and-organizational-performance/our-insights/ai-is-everywhere-the-agentic-organization-isnt-yet"
              emphasis
            />
            <StatBlock
              value="80%"
              label="of those same enterprises say they have not yet seen the investment reflected in the bottom line."
              source="McKinsey · The State of AI"
              sourceHref="https://www.mckinsey.com/capabilities/people-and-organizational-performance/our-insights/ai-is-everywhere-the-agentic-organization-isnt-yet"
              emphasis
            />
            <StatBlock
              value="19.36%"
              label="Pass@1 on multi-file agentic coding tasks — down from 87.2% on single-function benchmarks."
              source="Multi-file agentic coding benchmark"
            />
          </div>
        </div>
      </div>
    </Container>

    <div class="border-t border-ink-100 bg-white py-9 md:py-10">
      <HeadlineMarquee
        headlines={headlineTicker}
        ariaLabel="Enterprise AI headline ticker"
        durationSeconds={70}
      />
    </div>
  </section>

  <NarrativeSection id="problem" tone="default" width="wide">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(18rem,0.8fr)]">
      <div>
        <SectionHero
          eyebrow={problem.data.eyebrow}
          title={problem.data.title}
          lede={problem.data.lede}
        />
        <div class="prose-narrative mt-8 max-w-3xl">
          <ProblemBody.Content />
        </div>
      </div>

      <aside class="space-y-4 lg:mt-2" aria-label="Background concepts">
        <details class="panel group overflow-hidden">
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 [&::-webkit-details-marker]:hidden"
          >
            <h3 class="font-serif text-xl font-semibold text-ink-900">What is context?</h3>
            <span
              aria-hidden
              class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-ink-200 text-ink-600 transition-transform group-open:rotate-45"
              >+</span
            >
          </summary>
          <div class="border-t border-ink-100 px-6 py-5">
            <p class="text-[0.95rem] italic leading-relaxed text-ink-600">
              Context is the information an AI model or agent is given so it can answer a question,
              make a decision, write something, or complete a task. This can include instructions,
              documents, conversation history, policies, data from tools, and other relevant
              inputs.
            </p>
          </div>
        </details>
        <details class="panel group overflow-hidden">
          <summary
            class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 [&::-webkit-details-marker]:hidden"
          >
            <h3 class="font-serif text-xl font-semibold text-ink-900">What are tokens?</h3>
            <span
              aria-hidden
              class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-ink-200 text-ink-600 transition-transform group-open:rotate-45"
              >+</span
            >
          </summary>
          <div class="border-t border-ink-100 px-6 py-5">
            <p class="text-[0.95rem] italic leading-relaxed text-ink-600">
              Tokens are the small units of text AI systems read and produce. In practice, they
              roughly correspond to pieces of words and sentences. The more context an AI system
              processes and the more it writes back, the more tokens are used — and token usage
              directly affects cost.
            </p>
          </div>
        </details>

        <figure class="border-l-2 border-accent pl-5 pt-2">
          <blockquote class="font-serif text-lg leading-snug text-ink-800">
            “AI capabilities continue to accelerate while the governance frameworks, evaluation
            benchmarks, and transparency mechanisms needed to manage them fall further behind.”
          </blockquote>
          <figcaption class="mt-3 text-sm text-ink-500">
            <a
              href="https://hai.stanford.edu/ai-index/2026-ai-index-report"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-500 underline decoration-ink-200 underline-offset-2 transition-colors hover:text-ink-800 hover:decoration-ink-500"
            >
              Stanford HAI&rsquo;s 2026 AI Index Report (April 13, 2026)
            </a>
          </figcaption>
        </figure>

        <figure class="border-l-2 border-accent pl-5 pt-2">
          <blockquote class="font-serif text-lg leading-snug text-ink-800">
            “Context is similar for agents and people. Context to me is all the information you
            need to be good at your job.”
          </blockquote>
          <figcaption class="mt-3 text-sm text-ink-500">
            <a
              href="https://softwareengineeringdaily.com/2026/03/05/organizational-context-for-ai-coding-agents-with-dennis-pilarinos/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-500 underline decoration-ink-200 underline-offset-2 transition-colors hover:text-ink-800 hover:decoration-ink-500"
            >
              Dennis Pilarinos, Unblocked CEO, on the Software Engineering Daily podcast (March
              25, 2026)
            </a>
          </figcaption>
        </figure>
      </aside>
    </div>

    <div class="mt-20 max-w-3xl">
      <h3
        class="font-serif text-3xl font-semibold tracking-tight text-ink-900 md:text-display-sm"
      >
        More context is not uniformly better. Beyond a threshold, it degrades performance. The
        enterprise fix is not a bigger window — it is a governed, scoped, authority-aware
        retrieval layer.
      </h3>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <StatBlock
        value="CSR ≠ ISR"
        label="An agent that follows 9 of 10 constraints gets a perfect Constraint Success Rate — and an Instruction Success Rate of zero."
        source="Tsinghua · AGENTIF"
      />
      <StatBlock
        value="Context rot"
        label="Accuracy drops 68 pts when single-function benchmarks become multi-file, distributed tasks."
        source="Multi-file agentic coding benchmark"
      />
      <StatBlock
        value="Middle loss"
        label={'LLMs weight information at the start and end of long prompts more than information buried in the middle. The "needle in a haystack" problem.'}
        source="Chroma · Context Rot"
      />
    </div>

    <p class="mx-auto mt-12 max-w-2xl text-center text-lg leading-relaxed text-ink-700">
      Meanwhile, a new product category — <em>context engines</em> — has crystallized in early
      2026. Most of them are solving retrieval-over-code. Almost none are solving <strong
        class="font-semibold text-ink-900"
        >governed translation of stakeholder intent into scoped, authority-aware agent context.</strong
      >
    </p>

    <div class="mt-20 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {pressurePoints.map((point) => <TakeawayCard title={point.title}>{point.body}</TakeawayCard>)}
    </div>

    <div class="mt-20 max-w-3xl">
      <p class="eyebrow mb-3 text-accent">Landscape</p>
      <h3 class="font-serif text-2xl font-semibold text-ink-900 md:text-3xl">
        There are many perspectives to solving the enterprise context problem
      </h3>
    </div>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        landscapeLayers.map((layer) => (
          <article class="panel p-5">
            <h4 class="font-serif text-lg text-ink-900">{layer.title}</h4>
            <p class="mt-3 text-sm leading-relaxed text-ink-600">{layer.body}</p>
          </article>
        ))
      }
    </div>

    <CompetitorGrid
      title="The 2026 context-engine boom"
      eyebrow={null}
      competitors={contextEngines}
      stance="This work is not another context engine. It is the governance layer that sits above the retrieval layer — the part that decides what the agent is allowed to see, under whose authority, and with what audit obligation. It is customizable to fit an organization’s structure, governance needs, and intended agentic use cases."
    >
      <Fragment slot="subtitle">
        A dozen credible products crystallized into a single category in early 2026. Most are
        solving retrieval over code. <strong class="font-semibold text-ink-900"
          >Almost none are solving governed translation from enterprise intent into scoped,
          authority-aware agent context.</strong
        >
      </Fragment>
    </CompetitorGrid>

    <ComparisonBlock
      left={{
        label: 'Common pattern',
        title: 'Naive RAG',
        points: [
          'One flat searchable corpus with weak source boundaries.',
          'Questionnaire answers, policy, and informal discussion blend together.',
          'Similarity search becomes an implicit governance layer.',
          'Output quality depends on retrieval luck and prompt phrasing.',
        ],
      }}
      right={{
        label: 'This project',
        title: 'Governed agentic retrieval',
        points: [
          'Per-source lanes with dense, lexical, and direct structured access.',
          'Authority tiers and permissions preserved before the agent sees anything.',
          'Supervisor-planned subqueries and bundle assembly replace one-pass search.',
          'Escalations surface missing or conflicting evidence instead of hiding it.',
        ],
      }}
      emphasis="right"
    />

    <DetailExpander
      summary="Enterprise context is not the same as project context"
      kind="architecture"
      client:visible
    >
      Enterprise context includes security policies, compliance constraints, architecture
      principles, and access rules. Project context covers APIs, features, and sprint-level tasks.
      They overlap, but they are not interchangeable, and treating them as one bucket is how
      supposedly helpful assistants violate enterprise boundaries.
    </DetailExpander>
  </NarrativeSection>

  <NarrativeSection id="introduction" tone="muted" width="wide">
    <SectionHero eyebrow={intro.data.eyebrow} title={intro.data.title} lede={intro.data.lede} />
    <div class="prose-narrative mt-8 max-w-3xl">
      <IntroBody.Content />
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {
        framingCards.map((card) => (
          <TakeawayCard index={card.index} title={card.title}>
            {card.body}
          </TakeawayCard>
        ))
      }
    </div>

    <Callout kind="rationale" title="The source-of-truth inversion">
      The PRD remains the human stakeholder anchor, but the source of truth for execution shifts
      into the spec stack. The real product of governance is not a markdown document. It is an
      evidence-aware runtime package that tells the system what it may retrieve, how it should
      behave, and when it must stop.
    </Callout>

    <DetailExpander summary="What executable context actually contains" kind="spec" client:visible>
      <ul class="list-disc pl-5">
        {executableContext.map((item) => <li>{item}</li>)}
      </ul>
    </DetailExpander>
  </NarrativeSection>

  <NarrativeSection id="approach" tone="default" width="wide">
    <SectionHero
      eyebrow={approach.data.eyebrow}
      title={approach.data.title}
      lede={approach.data.lede}
    />
    <div class="prose-narrative mt-8 max-w-3xl">
      <ApproachBody.Content />
    </div>

    <div class="mt-12 grid gap-6 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
      <div>
        <h3 class="font-serif text-xl text-ink-900">The document stack</h3>
        <SpecHierarchy />
      </div>

      <div class="panel-muted p-6">
        <p class="eyebrow mb-3">Load-bearing decision</p>
        <h3 class="font-serif text-2xl text-ink-900">Keep the supervisor boring</h3>
        <p class="mt-4 text-sm leading-relaxed text-ink-600">
          The flashy version would make the supervisor another free-roaming model. The practical
          version makes orchestration a state machine and leaves interpretation to tightly scoped
          domain agents. That trade buys auditability, reproducibility, and cleaner failure
          analysis.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="chip">Deterministic gates</span>
          <span class="chip">Explicit state mutation</span>
          <span class="chip">Auditable retries</span>
        </div>
      </div>
    </div>

    <Callout kind="architecture" title="Hybrid search is not the full story">
      Hybrid search is the engine. Agentic retrieval is the planner, router, judge, and assembler
      around it. The system does not win because it has vectors and keywords. It wins because those
      capabilities are put inside a governed runtime path.
    </Callout>

    <div class="mt-14 grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(18rem,22rem)]">
      <div class="panel p-6">
        <p class="eyebrow mb-4">Retrieval flow</p>
        <ol class="space-y-3">
          {
            retrievalFlow.map((step, index) => (
              <li class="grid gap-3 rounded-2xl border border-ink-100 bg-paper-muted/70 px-4 py-4 md:grid-cols-[3rem_1fr]">
                <span class="font-mono text-sm text-ink-500">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <p class="text-sm leading-relaxed text-ink-700">{step}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="space-y-4">
        <div class="panel p-6">
          <p class="eyebrow mb-4">What the bundle carries</p>
          <ul class="space-y-3 text-sm leading-relaxed text-ink-700">
            {executableContext.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="panel p-6">
          <p class="eyebrow mb-4">Why the embedding step stays boring</p>
          <p class="text-sm leading-relaxed text-ink-600">
            The intelligence of the system is not in the embedding call. It is in the later routing,
            reranking, and bundle assembly where permissions, authority, and source fit are applied
            deliberately.
          </p>
        </div>
      </div>
    </div>

    <h3 class="mt-16 font-serif text-xl text-ink-900">Operating principles</h3>
    <PrincipleList items={approachPrinciples} />

    <h3 class="mt-16 font-serif text-xl text-ink-900">Domain agents in the pipeline</h3>
    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
      {domainAgents.map((agent) => <TakeawayCard title={agent.title}>{agent.body}</TakeawayCard>)}
    </div>

    <DetailExpander
      summary="Why this is not trying to be a generalized enterprise AI platform"
      kind="architecture"
      client:visible
    >
      The strength of the work is that it is concrete and governed. The presentation should not
      overclaim into a universal context engine, a GraphRAG platform, or a living-document
      automation suite. Those are interesting extensions, but they are not the value proposition
      demonstrated here.
    </DetailExpander>
  </NarrativeSection>

  <NarrativeSection id="scenario" tone="muted" width="wide">
    <SectionHero
      eyebrow={scenario.data.eyebrow}
      title={scenario.data.title}
      lede={scenario.data.lede}
    />
    <div class="prose-narrative mt-8 max-w-3xl">
      <ScenarioBody.Content />
    </div>

    <div class="mt-10 flex flex-wrap gap-2">
      <span class="chip">Path: regulated</span>
      <span class="chip">Outcome: escalated</span>
      <span class="chip">Fast-track: ineligible</span>
      <span class="chip">Approval path: standard</span>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
      {
        scenarioActs.map((act) => (
          <TakeawayCard index={act.index} title={act.title}>
            {act.body}
          </TakeawayCard>
        ))
      }
    </div>

    <Callout kind="rationale" title="Why this scenario works for the presentation">
      It forces the system to demonstrate prerequisite gating, regulated-path classification,
      domain-specific evidence use, escalation preservation, and stakeholder-ready next-step
      guidance. That makes the architecture visible without requiring a live backend.
    </Callout>

    <div class="mt-10 flex flex-wrap gap-3 text-sm">
      <a
        href="/demo"
        class="inline-flex items-center gap-2 rounded-full bg-ink-900 px-5 py-3 font-medium text-paper no-underline shadow-soft transition-colors hover:bg-ink-800"
      >
        See the three-pane replay
        <span aria-hidden>→</span>
      </a>
      <a
        href="/findings"
        class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-paper px-5 py-3 font-medium text-ink-800 no-underline transition-colors hover:border-ink-900"
      >
        Review the findings
      </a>
    </div>
  </NarrativeSection>
</BaseLayout>

