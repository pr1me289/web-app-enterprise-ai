          <line x1="558" y1="88" x2="558" y2="312" class="p-fluting" />
          <line x1="572" y1="88" x2="572" y2="312" class="p-fluting" />
          <line x1="583" y1="88" x2="583" y2="312" class="p-fluting" />
          <line x1="594" y1="88" x2="594" y2="312" class="p-fluting" />
