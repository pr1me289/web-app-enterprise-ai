---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/astro/Container.astro';
import SectionHero from '../components/astro/SectionHero.astro';
import Callout from '../components/astro/Callout.astro';
import StatementCallout from '../components/astro/StatementCallout.astro';
import StatusPill from '../components/astro/StatusPill.astro';
import ReplayConsole from '../components/react/ReplayConsole';
import runData from '../data/pipeline-run.json';

const { run, acts } = runData;
const startedAt = new Date(run.startedAt);
const completedAt = new Date(run.completedAt);
const durationSec = Math.round((completedAt.getTime() - startedAt.getTime()) / 1000);

const totalSteps = acts.reduce((sum, act) => sum + act.steps.length, 0);
const blockerCount = acts
  .flatMap((a) => a.steps)
  .reduce((sum, step) => sum + ((step as { blockers?: unknown[] }).blockers?.length ?? 0), 0);
---

<BaseLayout title="Demo · Pipeline replay">
  <section class="border-b border-ink-100 bg-paper-muted">
    <Container width="wide" class="py-16 md:py-20">
      <SectionHero
        as="h1"
        eyebrow="Part 06 · Demo"
        title="Five acts, one approval package"
        lede="A captured run of the governed pipeline against OptiChain. The story is the shape of the pipeline under real conditions — a blocking gate, a regulated classification, three domain reviews in three different states, and a final checklist that closes ESCALATED rather than fabricating COMPLETE."
      />

      <div class="mt-10 grid gap-3 md:grid-cols-5">
        <div class="rounded-md border border-ink-100 bg-paper p-4">
          <p class="eyebrow text-ink-400">Run ID</p>
          <p class="mt-1 font-mono text-[0.7rem] text-ink-700">{run.id}</p>
        </div>
        <div class="rounded-md border border-ink-100 bg-paper p-4">
          <p class="eyebrow text-ink-400">Acts</p>
          <p class="mt-1 text-sm text-ink-800">{acts.length} · {totalSteps} steps</p>
        </div>
        <div class="rounded-md border border-ink-100 bg-paper p-4">
          <p class="eyebrow text-ink-400">Duration</p>
          <p class="mt-1 text-sm text-ink-800">{durationSec}s end-to-end</p>
        </div>
        <div class="rounded-md border border-ink-100 bg-paper p-4">
          <p class="eyebrow text-ink-400">Outcome</p>
          <div class="mt-1"><StatusPill status={run.outcome} /></div>
        </div>
        <div class="rounded-md border border-ink-100 bg-paper p-4">
          <p class="eyebrow text-ink-400">Open blockers</p>
          <p class="mt-1 text-sm font-medium text-amber-800">{blockerCount} cited</p>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-section-sm md:py-section">
    <Container width="wide">
      <div class="mb-10 max-w-prose">
        <p class="text-sm leading-relaxed text-ink-600">{run.summary}</p>
      </div>

      <ReplayConsole run={run} acts={acts} client:load />

      <div class="mt-12 space-y-6">
        <StatementCallout eyebrow="Status vocabulary">
          The run uses five status values where the conceptual scenario used four and the implementation uses three. Preserving both is the honest move — the distinction drove the design even where the impl folded PROVISIONAL into ESCALATED.
        </StatementCallout>

        <div class="grid gap-3 md:grid-cols-5">
          {run.statusVocabulary.map((entry) => (
            <div class="rounded-md border border-ink-100 bg-paper p-4">
              <StatusPill status={entry.key} />
              <p class="mt-3 text-xs leading-relaxed text-ink-600">{entry.meaning}</p>
            </div>
          ))}
        </div>

        <Callout kind="architecture" title="What this replay is — and isn't">
          <p>
            v1 plays back a pre-captured run from <code>src/data/pipeline-run.json</code>. It is not a live backend call. The act structure, citation discipline, escalation flow, and null-passthrough behavior shown here match the upstream pipeline's real contract. The point is the <em>shape</em> of the output — an actionable approval package with cited blockers, not a fabricated &ldquo;complete.&rdquo;
          </p>
        </Callout>
      </div>
    </Container>
  </section>
</BaseLayout>
