---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/astro/Container.astro';
import DemoExperience from '../components/react/demo-codex/DemoExperience';
---

<BaseLayout title="Demo · Guided replay of a governed pipeline run">
  <section class="relative overflow-hidden border-b border-ink-100">
    <div class="hero-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true">
    </div>
    <Container width="wide" class="relative py-16 md:py-24">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(20rem,0.8fr)]">
        <div>
          <p class="eyebrow text-accent">Part 06 · Demo</p>
          <h1
            class="display-balance mt-5 max-w-[18ch] font-serif text-display-sm font-semibold leading-tight tracking-tight text-ink-900 md:text-display"
          >
            A guided replay of a governed pipeline run.
          </h1>
          <p class="lede mt-6 max-w-2xl">
            Watch the supervisor walk a precomputed onboarding pipeline through six governed steps —
            retrieving evidence by lane, assembling scoped bundles, dispatching to domain agents,
            validating output contracts, and either advancing or halting at each gate.
            <strong class="font-semibold text-accent"
              >This is a replay, but it is built from actual runs I conducted with the system.</strong
            > Four recorded runs are available.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <aside class="silver-panel max-w-none text-[0.95rem]">
            <span class="silver-panel__corner silver-panel__corner--tl" aria-hidden="true"></span>
            <span class="silver-panel__corner silver-panel__corner--br" aria-hidden="true"></span>
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-ink-500">
              How to read this page
            </p>
            <ul class="mt-3 space-y-2 text-sm leading-relaxed text-ink-700">
              <li>
                <strong class="font-semibold text-ink-900">Pick a scenario</strong> with the selector.
              </li>
              <li>
                <strong class="font-semibold text-ink-900">Press &lsquo;Start Replay&rsquo;</strong>.
                The execution bar will follow you down the page; use it to navigate.
              </li>
              <li>
                <strong class="font-semibold text-ink-900">Pause anytime</strong> and use the step
                / back buttons, or click any node to inspect a single step in detail.
              </li>
              <li>
                <strong class="font-semibold text-ink-900">Open the black drawers</strong> in the
                &ldquo;Technical Inspection&rdquo; section for full file previews.
              </li>
            </ul>
          </aside>

          <aside class="rounded-xl border border-ink-100 bg-paper p-5 shadow-soft">
            <p class="font-mono text-[0.65rem] uppercase tracking-[0.12em] text-ink-500">
              Status emissions
            </p>
            <ul class="mt-3 space-y-2.5">
              <li class="flex items-start gap-3">
                <span
                  class="inline-flex shrink-0 items-center rounded-full border border-spruce-700/30 bg-spruce-50 px-2.5 py-0.5 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-spruce-700"
                >
                  Complete
                </span>
                <p class="text-xs leading-relaxed text-ink-700">
                  Step succeeds and pipeline proceeds.
                </p>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="inline-flex shrink-0 items-center rounded-full border border-accent/40 bg-accent-soft/60 px-2.5 py-0.5 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-accent"
                >
                  Escalated
                </span>
                <p class="text-xs leading-relaxed text-ink-700">
                  Conflicting evidence or ambiguous decision.
                </p>
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="inline-flex shrink-0 items-center rounded-full border border-rose-700/30 bg-rose-50 px-2.5 py-0.5 font-mono text-[0.62rem] uppercase tracking-[0.1em] text-rose-700"
                >
                  Blocked
                </span>
                <p class="text-xs leading-relaxed text-ink-700">
                  Required evidence absent.
                </p>
              </li>
            </ul>
          </aside>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-section-sm md:py-section">
    <Container width="wide">
      <DemoExperience client:load />
    </Container>
  </section>
</BaseLayout>

<style>
  .hero-grid {
    background-image:
      radial-gradient(circle at 12% 22%, rgba(157, 87, 40, 0.08), transparent 32%),
      radial-gradient(circle at 88% 12%, rgba(33, 71, 60, 0.08), transparent 30%),
      linear-gradient(rgba(24, 33, 38, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(24, 33, 38, 0.09) 1px, transparent 1px);
    background-size:
      auto,
      auto,
      48px 48px,
      48px 48px;
    background-position:
      0 0,
      0 0,
      0 0,
      0 0;
    mask-image: radial-gradient(ellipse at top, black 50%, transparent 88%);
  }

  .silver-panel {
    position: relative;
    isolation: isolate;
    padding: 1.5rem 1.75rem;
    border-radius: 0.9rem;
    background:
      linear-gradient(135deg, #f6f8fa 0%, #dde3e8 22%, #f1f4f6 48%, #c8d0d7 74%, #e8ecef 100%);
    border: 1px solid rgba(24, 33, 38, 0.14);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      inset 0 -1px 0 rgba(24, 33, 38, 0.18),
      0 1px 2px rgba(24, 33, 38, 0.06),
      0 10px 28px -14px rgba(24, 33, 38, 0.22);
  }

  .silver-panel__corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid rgba(24, 33, 38, 0.45);
    pointer-events: none;
  }

  .silver-panel__corner--tl {
    top: 8px;
    left: 8px;
    border-right: none;
    border-bottom: none;
  }

  .silver-panel__corner--br {
    bottom: 8px;
    right: 8px;
    border-left: none;
    border-top: none;
  }
</style>
