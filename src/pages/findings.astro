---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/astro/Container.astro';
---

<BaseLayout
  title="Summary"
  description="A concise closing summary of the spec-driven enterprise context engineering presentation."
>
  <section class="relative isolate overflow-hidden border-b border-ink-100 bg-paper">
    <div class="summary-aurora pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="summary-grain pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <Container width="wide" class="relative py-6 md:py-10">
      <!-- Title — anchored to the top of the page -->
      <h1
        class="display-balance mx-auto max-w-5xl text-center font-serif text-display-sm font-semibold leading-[1.05] tracking-tight text-ink-900 md:text-display"
      >
        The story this project
        <span class="mt-1 block italic text-accent">is really telling.</span>
      </h1>

      <!-- Ornamental divider -->
      <div
        class="mx-auto mt-10 flex w-full max-w-md items-center gap-3 md:mt-14"
        aria-hidden="true"
      >
        <span class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-200 to-transparent"
        ></span>
        <span class="text-sm text-accent">◆</span>
        <span class="h-px flex-1 bg-gradient-to-l from-transparent via-ink-200 to-transparent"
        ></span>
      </div>

      <!-- The two theses -->
      <div class="mx-auto mt-10 max-w-5xl space-y-12 md:mt-14 md:space-y-16">
        <!-- Thesis I — warm / accent · anchored left -->
        <article
          class="grid gap-6 md:max-w-3xl md:grid-cols-[minmax(0,5rem)_minmax(0,1fr)] md:items-start md:gap-12"
        >
          <p
            aria-hidden="true"
            class="font-serif text-7xl font-semibold italic leading-none tracking-tight text-accent/90 md:text-[8rem]"
          >
            I
          </p>
          <div>
            <p class="thesis-prose thesis-prose--warm">
              Hand building enterprise-ready agentic infrastructure from scratch
              <em class="thesis-emphasis thesis-emphasis--warm">forces</em>
              stakeholders to confront the friction between LLM behavior and enterprise constraints.
            </p>
            <span
              aria-hidden="true"
              class="mt-6 block h-px w-16 bg-gradient-to-r from-accent/70 to-transparent"
            ></span>
          </div>
        </article>

        <!-- Thesis II — cool / spruce · anchored right -->
        <article
          class="ml-auto grid gap-6 md:max-w-3xl md:grid-cols-[minmax(0,1fr)_minmax(0,5rem)] md:items-start md:gap-12"
        >
          <div class="md:order-1 md:text-right">
            <p class="thesis-prose thesis-prose--cool md:ml-auto">
              End-to-end spec-driven development
              <em class="thesis-emphasis thesis-emphasis--cool">forces</em>
              ALL stakeholders to confront the security, compliance, governance, and reliability
              demands of deploying AI inside a real business.
            </p>
            <span
              aria-hidden="true"
              class="mt-6 block h-px w-16 bg-gradient-to-l from-spruce-700/70 to-transparent md:ml-auto"
            ></span>
          </div>
          <p
            aria-hidden="true"
            class="font-serif text-7xl font-semibold italic leading-none tracking-tight text-spruce-700/85 md:order-2 md:text-[8rem]"
          >
            II
          </p>
        </article>
      </div>

      <!-- Closing rule -->
      <div
        class="mx-auto mt-14 flex w-full max-w-md items-center gap-3 md:mt-20"
        aria-hidden="true"
      >
        <span class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-200 to-transparent"
        ></span>
        <span class="text-[0.7rem] text-accent">◆</span>
        <span class="h-px flex-1 bg-gradient-to-l from-transparent via-ink-200 to-transparent"
        ></span>
      </div>
    </Container>
  </section>

  <section class="relative isolate overflow-hidden py-section-sm md:py-section">
    <div class="repos-aurora pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="repos-grain pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <!-- Decorative corner glyphs -->
    <span class="repos-corner repos-corner--tl" aria-hidden="true"></span>
    <span class="repos-corner repos-corner--br" aria-hidden="true"></span>

    <Container width="wide" class="relative">
      <div class="mx-auto max-w-5xl">
        <div class="relative text-center">
          <p class="eyebrow text-accent">The source</p>
          <h2
            class="display-balance mx-auto mt-4 max-w-3xl font-serif text-3xl font-semibold leading-tight tracking-tight text-ink-900 md:text-4xl"
          >
            Two repositories — the presentation, and the system that powers it.
          </h2>
          <!-- Soft halo behind heading -->
          <span aria-hidden="true" class="repos-heading-glow"></span>
        </div>

        <!-- Ornamental divider between heading and cards -->
        <div
          class="mx-auto mt-10 flex w-full max-w-md items-center gap-3 md:mt-12"
          aria-hidden="true"
        >
          <span class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-200 to-transparent"
          ></span>
          <span class="text-sm text-accent">◆</span>
          <span class="h-px flex-1 bg-gradient-to-l from-transparent via-ink-200 to-transparent"
          ></span>
        </div>

        <div class="mt-10 grid gap-6 md:mt-12 md:grid-cols-2 md:gap-8">
          <!-- Repo I — Web app presentation (warm) -->
          <article class="repo-card repo-card--warm">
            <div class="flex items-center gap-3">
              <span class="repo-card__index repo-card__index--warm">I</span>
              <p
                class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-accent"
              >
                Web app presentation
              </p>
            </div>
            <h3
              class="mt-5 font-serif text-2xl font-semibold leading-snug text-ink-900 md:text-[1.6rem]"
            >
              This narrative site.
            </h3>
            <p class="mt-3 text-base leading-relaxed text-ink-700">
              Astro static site with MDX prose and React islands. Presents my research, the
              spec-driven approach, the architecture, and the four captured pipeline replays.
            </p>
            <a
              href="https://github.com/pr1me289/web-app-enterprise-ai"
              target="_blank"
              rel="noopener noreferrer"
              class="repo-card__link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-4 w-4 shrink-0"
                aria-hidden="true"
              >
                <path
                  d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.16-.01-2.1-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.19 1.78 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
                />
              </svg>
              <span class="truncate">github.com/pr1me289/web-app-enterprise-ai</span>
              <span aria-hidden="true" class="ml-1 shrink-0">↗</span>
            </a>
          </article>

          <!-- Repo II — The system (cool) -->
          <article class="repo-card repo-card--cool">
            <div class="flex items-center gap-3">
              <span class="repo-card__index repo-card__index--cool">II</span>
              <p
                class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-spruce-700"
              >
                The system
              </p>
            </div>
            <h3
              class="mt-5 font-serif text-2xl font-semibold leading-snug text-ink-900 md:text-[1.6rem]"
            >
              The engineering repository.
            </h3>
            <p class="mt-3 text-base leading-relaxed text-ink-700">
              The orchestration layer, retrieval layer, chunking and embedding, storage and
              indexing, cross-encoder reranking, the deterministic supervisor, and the agent
              specs that govern every domain agent.
            </p>
            <a
              href="https://github.com/pr1me289/enterprise_ai"
              target="_blank"
              rel="noopener noreferrer"
              class="repo-card__link"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-4 w-4 shrink-0"
                aria-hidden="true"
              >
                <path
                  d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-1.16-.01-2.1-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.19 1.78 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
                />
              </svg>
              <span class="truncate">github.com/pr1me289/enterprise_ai</span>
              <span aria-hidden="true" class="ml-1 shrink-0">↗</span>
            </a>
          </article>
        </div>

        <!-- Contact / colophon -->
        <div class="mx-auto mt-20 max-w-3xl text-center md:mt-28">
          <div
            class="mx-auto flex w-full max-w-md items-center gap-3"
            aria-hidden="true"
          >
            <span
              class="h-px flex-1 bg-gradient-to-r from-transparent via-ink-200 to-transparent"
            ></span>
            <span class="text-sm text-accent">◆</span>
            <span
              class="h-px flex-1 bg-gradient-to-l from-transparent via-ink-200 to-transparent"
            ></span>
          </div>

          <p class="eyebrow mt-10 text-accent">Get in touch</p>

          <p
            class="mx-auto mt-5 max-w-2xl font-serif text-xl leading-snug text-ink-800 md:text-2xl"
          >
            I&rsquo;d welcome the conversation — about this project, the architecture behind it,
            or related work in the space.
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
              href="https://www.linkedin.com/in/pierce-nellessen-188366197/"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-pill"
              aria-label="LinkedIn — Pierce Nellessen"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-4 w-4 shrink-0"
                aria-hidden="true"
              >
                <path
                  d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"
                />
              </svg>
              <span>linkedin.com/in/pierce-nellessen</span>
              <span aria-hidden="true" class="ml-0.5 text-ink-400">↗</span>
            </a>
            <a
              href="mailto:nellessen.pierce12@gmail.com"
              class="contact-pill"
              aria-label="Email — nellessen.pierce12@gmail.com"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-4 w-4 shrink-0"
                aria-hidden="true"
              >
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
              <span>nellessen.pierce12@gmail.com</span>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* ----- Hero ambiance ---------------------------------------------------- */

  /* Hero ends with rich cool blooms at the bottom — no paper-fade at the
     seam so the section blends into the second-page aurora rather than
     resetting to bare paper. */
  .summary-aurora {
    background:
      radial-gradient(72% 60% at 82% -4%, rgba(157, 87, 40, 0.22), transparent 62%),
      radial-gradient(56% 48% at 0% 22%, rgba(157, 87, 40, 0.1), transparent 64%),
      radial-gradient(72% 62% at 100% 86%, rgba(33, 71, 60, 0.2), transparent 60%),
      radial-gradient(78% 62% at 14% 104%, rgba(33, 71, 60, 0.16), transparent 70%);
  }

  .summary-grain {
    background-image: radial-gradient(rgba(24, 33, 38, 0.06) 0.6px, transparent 0.7px);
    background-size: 18px 18px;
    mask-image: radial-gradient(ellipse at center, black 28%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 28%, transparent 78%);
    opacity: 0.6;
  }

  /* ----- Two-thesis prose ------------------------------------------------- */

  .thesis-prose {
    position: relative;
    isolation: isolate;
    font-family: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
    font-size: clamp(1.4rem, 2vw, 2.15rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.014em;
    color: #182126;
    max-width: 38rem;
    text-wrap: balance;
    margin: 0;
  }

  /* Translucent ambient glow behind each thesis paragraph */
  .thesis-prose::before {
    content: '';
    position: absolute;
    inset: -1.75rem -2.25rem;
    z-index: -1;
    border-radius: 999px;
    filter: blur(40px);
    opacity: 0.55;
    pointer-events: none;
  }

  .thesis-prose--warm::before {
    background: radial-gradient(
      ellipse at center,
      rgba(157, 87, 40, 0.55),
      rgba(157, 87, 40, 0) 70%
    );
  }

  .thesis-prose--cool::before {
    background: radial-gradient(
      ellipse at center,
      rgba(33, 71, 60, 0.5),
      rgba(33, 71, 60, 0) 70%
    );
  }

  /* ----- "forces" emphasis — soft glow underline -------------------------- */

  .thesis-emphasis {
    position: relative;
    font-style: italic;
    font-weight: 700;
    padding: 0 0.04em;
  }

  .thesis-emphasis::after {
    content: '';
    position: absolute;
    left: 0.05em;
    right: 0.05em;
    bottom: -0.08em;
    height: 0.32em;
    z-index: -1;
    border-radius: 999px;
    filter: blur(2px);
  }

  .thesis-emphasis--warm {
    color: #9d5728;
  }

  .thesis-emphasis--warm::after {
    background: linear-gradient(120deg, rgba(157, 87, 40, 0.32), rgba(157, 87, 40, 0));
  }

  .thesis-emphasis--cool {
    color: #21473c;
  }

  .thesis-emphasis--cool::after {
    background: linear-gradient(240deg, rgba(33, 71, 60, 0.28), rgba(33, 71, 60, 0));
  }

  /* ----- Repository cards (second-page source presentation) -------------- */

  /* Second section picks up where the hero leaves off — cool blooms at the
     top edge meet the hero's cool-bottom blooms for a continuous wash, then
     the warmth returns at the bottom of the page so the colour cycles
     warm → cool → cool → warm vertically across the two sections. */
  .repos-aurora {
    background:
      radial-gradient(64% 50% at 8% -4%, rgba(33, 71, 60, 0.18), transparent 64%),
      radial-gradient(56% 44% at 96% -2%, rgba(33, 71, 60, 0.14), transparent 66%),
      radial-gradient(64% 54% at 96% 70%, rgba(157, 87, 40, 0.18), transparent 62%),
      radial-gradient(60% 52% at 4% 96%, rgba(157, 87, 40, 0.16), transparent 68%),
      radial-gradient(50% 38% at 50% 50%, rgba(252, 250, 245, 0.35), transparent 70%);
  }

  .repos-grain {
    background-image: radial-gradient(rgba(24, 33, 38, 0.05) 0.5px, transparent 0.6px);
    background-size: 18px 18px;
    mask-image: radial-gradient(ellipse at center, black 28%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 28%, transparent 80%);
    opacity: 0.55;
  }

  /* Soft halo behind the section heading — paper-cream so it pops out of
     the cool zone at the top of this section without clashing. */
  .repos-heading-glow {
    position: absolute;
    inset: -1.5rem 22% -1rem;
    z-index: -1;
    border-radius: 999px;
    background: radial-gradient(
      ellipse at center,
      rgba(252, 250, 245, 0.65),
      rgba(252, 250, 245, 0) 72%
    );
    filter: blur(34px);
    pointer-events: none;
  }

  /* Ornamental corner glyphs — colors mirror their nearest aurora bloom:
     cool at top-left, warm at bottom-right. */
  .repos-corner {
    position: absolute;
    width: 22px;
    height: 22px;
    transform: rotate(45deg);
    pointer-events: none;
  }

  .repos-corner--tl {
    top: 2.5rem;
    left: 2rem;
    border: 1px solid rgba(33, 71, 60, 0.5);
  }

  .repos-corner--br {
    right: 2rem;
    bottom: 2.5rem;
    border: 1px solid rgba(157, 87, 40, 0.5);
  }

  @media (max-width: 767px) {
    .repos-corner {
      display: none;
    }
  }

  .repo-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    border-radius: 1.5rem;
    border: 1px solid rgba(24, 33, 38, 0.08);
    background: rgba(252, 250, 245, 0.85);
    padding: 1.75rem;
    box-shadow:
      0 18px 42px -22px rgba(24, 33, 38, 0.18),
      0 1px 2px rgba(24, 33, 38, 0.04);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  @media (min-width: 768px) {
    .repo-card {
      padding: 2.25rem;
    }
  }

  .repo-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    opacity: 0.55;
    pointer-events: none;
  }

  .repo-card--warm::before {
    background: radial-gradient(120% 120% at 0% 0%, rgba(157, 87, 40, 0.18), transparent 60%);
  }

  .repo-card--cool::before {
    background: radial-gradient(120% 120% at 100% 100%, rgba(33, 71, 60, 0.18), transparent 60%);
  }

  .repo-card--warm:hover {
    border-color: rgba(157, 87, 40, 0.45);
    transform: translateY(-2px);
  }

  .repo-card--cool:hover {
    border-color: rgba(33, 71, 60, 0.45);
  }

  .repo-card__index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.55rem;
    border-radius: 999px;
    font-family: 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif;
    font-size: 1rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1;
  }

  .repo-card__index--warm {
    color: #9d5728;
    background: rgba(157, 87, 40, 0.1);
    border: 1px solid rgba(157, 87, 40, 0.28);
  }

  .repo-card__index--cool {
    color: #21473c;
    background: rgba(33, 71, 60, 0.1);
    border: 1px solid rgba(33, 71, 60, 0.28);
  }

  .repo-card__link {
    margin-top: auto;
    padding-top: 1.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    color: #182126;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .repo-card__link[href]:hover {
    color: #9d5728;
  }

  .repo-card__link[href]:hover svg {
    transform: translate(0, -1px);
  }

  .repo-card__link svg {
    transition: transform 200ms ease;
  }

  .repo-card__link--pending {
    color: rgba(24, 33, 38, 0.5);
    cursor: default;
    font-style: normal;
  }

  .repo-card__link--pending svg {
    opacity: 0.55;
  }

  /* ----- Contact pills (colophon) ---------------------------------------- */

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(24, 33, 38, 0.12);
    background: rgba(252, 250, 245, 0.85);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.78rem;
    letter-spacing: 0.01em;
    color: #182126;
    text-decoration: none;
    transition:
      border-color 200ms ease,
      color 200ms ease,
      transform 200ms ease,
      background 200ms ease;
  }

  .contact-pill:hover {
    color: #9d5728;
    border-color: rgba(157, 87, 40, 0.45);
    background: rgba(252, 250, 245, 1);
    transform: translateY(-1px);
  }

  .contact-pill:hover svg {
    color: #9d5728;
  }
</style>
