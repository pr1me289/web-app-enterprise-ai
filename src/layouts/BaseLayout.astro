---
import '../styles/global.css';
import SiteHeader from '../components/astro/SiteHeader.astro';
import SiteFooter from '../components/astro/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  hideHeader?: boolean;
}

const {
  title,
  description = 'A spec-driven approach to enterprise context engineering — governance, orchestration, and retrieval for LLM agents over enterprise data.',
  hideHeader = false,
} = Astro.props;

const fullTitle = title.includes('Spec-Driven') ? title : `${title} — Spec-Driven Enterprise AI`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    {!hideHeader && <SiteHeader />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
